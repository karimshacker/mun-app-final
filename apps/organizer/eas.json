{
  "cli": {
    "version": ">= 11.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://mianu-api.karimshacker1234.workers.dev"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://mianu-api.karimshacker1234.workers.dev"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "FILL_ME_ASC_APP_ID",
        "ascApiKeyPath": "../../.secrets/apple/AuthKey.p8",
        "ascApiKeyIssuerId": "FILL_ME_ISSUER_ID",
        "ascApiKeyId": "FILL_ME_KEY_ID"
      }
    }
  }
}
