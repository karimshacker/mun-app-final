{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@mianu/types": [
        "../../packages/types/src"
      ],
      "@mianu/ui": [
        "../../packages/ui/src"
      ],
      "@mianu/api-client": [
        "../../packages/api-client/src"
      ]
    }
  },
  "include": [
    "src"
  ],
  "extends": "expo/tsconfig.base"
}
