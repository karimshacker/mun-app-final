# Dependencies
node_modules/
.pnp/
.pnp.js/

# Builds
dist/
build/
.expo/
*.tsbuildinfo

# Cloudflare
.wrangler/
.dev.vars
.mf/

# Env & secrets
.env
.env.local
*.local
# Staff PINs — generated out-of-band, never committed
.staff-credentials.txt
# Apple signing & upload credentials — provided out-of-band, never committed
.secrets/apple/
*.p8
*.p12
*.cer
*.mobileprovision
*.provisionprofile
*.pem

# Native
ios/
android/
# Marker left by packages/build/strip-ios-nfc-entitlements.mjs so prebuild
# restores the stripped NFC entitlements for the next (paid/NFC) build
.ios-free-mode

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
*.log
npm-debug.log*

# UI preview harness: generated bundles and screenshots are build output
packages/preview/.preview/
packages/preview/shots/
.test-bundle.mjs
